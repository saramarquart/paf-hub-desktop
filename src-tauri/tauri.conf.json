{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Planet A Foods",
  "version": "0.2.1",
  "identifier": "com.planetafoods.hub",
  "build": {
    "frontendDist": "../src"
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["planetafoods"]
      }
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Planet A Foods",
        "url": "https://hub.planet-a-foods.com/",
        "width": 1280,
        "height": 832,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Planet A Foods app hub",
    "longDescription": "Native launcher for the Planet A Foods app hub. Opens the hub in its own window and keeps you inside one app as you move between the internal tools \u2014 QOaroma (aroma & formulation analytics), paf_note (wiki, notes & OKRs), paf_feedback (team feedback & HR), paf_commodity (cocoa & FX prices) and paf_coa (certificates of analysis). Third-party SaaS tiles open in your default browser.",
    "publisher": "Planet A Foods",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    },
    "macOS": {
      "signingIdentity": null,
      "minimumSystemVersion": "10.15"
    }
  }
}
